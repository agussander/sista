# Copiá este archivo a .deploy.env y completá la contraseña.
#   cp .deploy.env.example .deploy.env
FTP_HOST=sista.ar
FTP_PORT=21
FTP_USER=agustin
FTP_PASS=TU_CONTRASEÑA_ACA

# true  -> usa FTPS (cifrado) si el servidor lo ofrece; si no, FTP plano.
# no    -> fuerza FTP plano (sin cifrar).
FTP_SSL=true

# Transferencias en paralelo (conservador = 2; subilo si el server no se queja).
FTP_PARALLEL=2
