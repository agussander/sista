# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — Sista (sitio estático)
# =============================================================================
# Copia este archivo a .env y rellena los valores.
# El archivo .env está en .gitignore y no se sube al repositorio.
#
# Cliente (Svelte/Vite): solo las variables con prefijo VITE_ se exponen al
# código del navegador en tiempo de build. Usar solo para datos no secretos
# (ej. URL de PocketBase, clave de sitio reCAPTCHA).
#
# Servidor/PHP: las variables sin prefijo VITE_ son para uso en PHP o en el
# servidor. Configura tu hosting para inyectarlas o usa un loader de .env en PHP.
# =============================================================================

# -----------------------------------------------------------------------------
# Cliente (prefijo VITE_ — se incluyen en el build estático)
# -----------------------------------------------------------------------------

# URL de la instancia de PocketBase
VITE_POCKETBASE_URL=https://sista.pockethost.io

# Clave de sitio reCAPTCHA (pública, para formularios en el navegador)
# Formulario de contacto / modal: si usas reCAPTCHA v3, pon aquí la site key.
VITE_RECAPTCHA_SITE_KEY=

# Clave de sitio reCAPTCHA para solicitud de baja (Enterprise/v3)
VITE_RECAPTCHA_SITE_KEY_BAJA=

# -----------------------------------------------------------------------------
# Servidor / PHP (no usar en código cliente)
# -----------------------------------------------------------------------------

# SMTP (MailHandler.php — envío de correos desde formularios)
SMTP_HOST=mail.sista.ar
SMTP_PORT=587
SMTP_USER=contactoweb@sista.com.ar
SMTP_PASSWORD=

# reCAPTCHA v3 — clave secreta (form-handler.php, validación en servidor)
RECAPTCHA_SECRET_KEY=

# API IspCube (solicitud de baja, tickets)
ISPCUBE_API_URL=https://sista.ispcube.online
ISPCUBE_USERNAME=api_web
ISPCUBE_PASSWORD=
ISPCUBE_API_KEY=
ISPCUBE_CLIENT_ID=734

# reCAPTCHA Enterprise (client-handler.php) — API key si se usa
RECAPTCHA_ENTERPRISE_API_KEY=
